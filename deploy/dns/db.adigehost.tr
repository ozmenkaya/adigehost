	  "aCp8LuvlspYw5XRpv1FF3G/QUZgX7WWQF8pLkIbRK3ZRFAsfG1vovW1gTAs9N0mB32+2Zovfp3sJJPobm8cazF3lyvjRDqOdr36hnYyPkI/+oVrWJxUkjP1z7eIn6iJkdtp9OOQQIDAQAB" )  ; DKIM key mail for adigehost.tr
