# ============================================
# AdigeHost Backend - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun.
# ASLA gerçek .env dosyasını git'e commit etmeyin.
# ============================================

# --- Uygulama ---
NODE_ENV=development
PORT=5000
APP_NAME=AdigeHost
APP_URL=https://panel.adigehost.com
FRONTEND_URL=https://panel.adigehost.com
# Virgülle ayrılmış izinli origin'ler (CORS)
CORS_ORIGINS=http://localhost:5173,https://panel.adigehost.com

# --- Veritabanı (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adigehost
DB_USER=adigehost_user
DB_PASS=
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (min 64 karakter güçlü secret) ---
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Şifreleme (AES-256-GCM için 32 byte = 64 hex karakter) ---
# Üretmek için: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Hetzner Cloud ---
HETZNER_API_TOKEN=

# --- WHM / cPanel ---
WHM_HOST=
WHM_PORT=2087
WHM_USER=root
WHM_API_TOKEN=

# --- DomainNameAPI (Atak Domain) ---
DOMAIN_API_URL=https://api.domainnameapi.com/DomainNameService.svc
DOMAIN_API_USER=
DOMAIN_API_PASS=

# --- İyzico ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- EDM Bilişim (E-Fatura SOAP) ---
EDM_WSDL_URL=
EDM_USER=
EDM_PASS=
EDM_TEST_MODE=true

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- SMTP (Nodemailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AdigeHost <noreply@adigehost.tr>

# --- Admin (seed için ilk admin) ---
ADMIN_EMAIL=admin@adigehost.tr
ADMIN_PASS=

# --- Loglama ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Faturalandırma varsayılanları ---
VAT_RATE=20
CURRENCY=TRY
